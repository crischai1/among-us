# Copy to .env and fill in. Real environment variables override these.

# Free-tier LLM for bot meeting chat. Leave empty for built-in lines.
# Groq: free key at https://console.groq.com  |  Gemini: free key at https://aistudio.google.com
BOT_LLM_KEY=
# groq (default) or gemini
BOT_LLM_PROVIDER=groq
# Optional overrides
# BOT_LLM_MODEL=
# BOT_LLM_RPM=
